<div class="auth-page">

    <div class="auth-card">

        <div class="auth-header">

            <h1>KPI Verimlilik</h1>

            <p>
                Hedeflerinizi ve performansınızı
                takip etmek için giriş yapın.
            </p>

        </div>

        @if (TempData["Hata"] != null)
        {
            <div class="auth-error">
                @TempData["Hata"]
            </div>
        }

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            <div class="auth-form-group">

                <label>E-posta</label>

                <input type="email"
                       name="Email"
                       placeholder="ornek@mail.com"
                       required />

            </div>

            <div class="auth-form-group">

                <label>Şifre</label>

                <input type="password"
                       name="SifreHash"
                       placeholder="Şifrenizi girin"
                       required />

            </div>

            <button type="submit"
                    class="auth-button">
                Giriş Yap
            </button>

        </form>

        <div class="auth-footer">

            <span>Hesabınız yok mu?</span>

            <a asp-controller="Account"
               asp-action="Register">
                Kayıt Ol
            </a>

        </div>

    </div>

</div>